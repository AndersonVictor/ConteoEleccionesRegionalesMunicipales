# Copia este archivo como .env y completa los valores. .env NO se sube al repositorio.

# Token de https://decolecta.com para autocompletar nombres por DNI (RENIEC).
DECOLECTA_TOKEN=

# Clave para firmar las sesiones. Obligatoria en modo microservicios (todas las réplicas la comparten).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=

# Vacío = SQLite en data/conteo.db. Para alto tráfico, PostgreSQL:
# DATABASE_URL=postgres://conteo:clave@localhost:5432/conteo
DATABASE_URL=

# Opcional: Redis para compartir caché y límites entre réplicas.
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# DNIs (separados por coma) que se registran como administradores.
ADMIN_DNIS=

# Contraseña de PostgreSQL usada por docker-compose.
POSTGRES_PASSWORD=cambia-esta-clave

# 0 = los resultados solo los ven personeros con cuenta (por defecto son públicos).
DASHBOARD_PUBLICO=1

# Fin del modo prueba (hora de Perú). A esta hora se borran mesas y actas de prueba.
ELECCION_INICIO=2026-10-04T08:00:00-05:00
